bb038c2f4164"],

Cell[TextData[{
 "En av ",
 StyleBox["Mathematicas",
  FontSlant->"Italic"],
 " st\[ODoubleDot]rsta f\[ODoubleDot]rdelar genemot en vanlig minir\
\[ADoubleDot]knare, \[ADoubleDot]r just dess f\[ODoubleDot]rm\[ARing]ga att \
manipulera s\[ARing]dana symboliska uttryck. Ovanst\[ARing]ende uttryck \
tolkar vi som ett polynom i variabeln ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "400381c3-d415-4b00-85f0-87096a9a6183"],
 ". "
}], "Text",
 CellChangeTimes->{{3.461311292887312*^9, 3.461311369094719*^9}, {
   3.461311405025205*^9, 3.46131145730663*^9}, {3.461318424219177*^9, 
   3.461318436060598*^9}, {3.461318552622772*^9, 3.461318589421002*^9}, 
   3.461318791001346*^9},ExpressionUUID->"86c28256-9e77-4847-8aa8-\
5acb2bb25700"],

Cell[TextData[{
 "Det finns ett stort antal inbyggda funktioner i ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " som manipulerar symboliska uttryck. H\[ADoubleDot]r anv\[ADoubleDot]nder \
vi funktionen ",
 ButtonBox["D",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/D"],
 " f\[ODoubleDot]r att be ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " att derivera uttrycket ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "771cab17-fea0-492e-98ea-6f8266d6b89c"],
 " med avseende p\[ARing] ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "3421206c-5fe0-4cfa-964c-014a6739a6f0"],
 "."
}], "Text",
 CellChangeTimes->{{3.461318981060422*^9, 3.461318996762178*^9}, {
   3.461319354046885*^9, 3.461319418668515*^9}, {3.461319464912151*^9, 
   3.461319464913111*^9}, {3.461319497281119*^9, 3.461319499232151*^9}, 
   3.461320393495452*^9, {3.461320435028607*^9, 
   3.461320439146454*^9}},ExpressionUUID->"511c150d-02e9-4645-b023-\
2f0f3cc9e6cb"],

