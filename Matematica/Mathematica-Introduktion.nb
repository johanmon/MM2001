Cell[TextData[{
 "Det finns m\[ARing]nga andra inbyggda standardfunktioner. Dessa skrivs \
generellt p\[ARing] formen ",
 StyleBox["Funktion[arg]", "Input"],
 ". ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " skiljer p\[ARing] stora och sm\[ARing] bokst\[ADoubleDot]ver. Alla \
inbyggda funktioner b\[ODoubleDot]rjar med stor bokstav, och input till \
funktioner skrivs inom hakparenteser. Tar funktionen fler argument s\[ARing] \
separeras dessa med kommatecken. ",
 StyleBox["Observera!",
  FontSlant->"Italic"],
 " Detta skiljer sig ibland i fr\[ARing]n hur man normalt skriver matematisk \
text. Exempelvis skriver man normalt ",
 StyleBox["sin \[Pi]", "InlineFormula"],
 " n\[ADoubleDot]r man menar \[OpenCurlyDoubleQuote]sinus f\[ODoubleDot]r pi\
\[CloseCurlyDoubleQuote]. I ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " m\[ARing]ste man skriva s\[ARing] h\[ADoubleDot]r:"
}], "Text",
 CellChangeTimes->{{3.461304408690483*^9, 3.461304420270637*^9}, {
  3.461304503237579*^9, 3.461304575303441*^9}, {3.461304715856278*^9, 
  3.461304760425232*^9}, {3.461304798977022*^9, 3.461304918514487*^9}, {
  3.461305311911057*^9, 3.461305328119968*^9}, {3.461308350983206*^9, 
  3.461308396944946*^9}, {3.461320910228664*^9, 3.461320910690667*^9}, {
  3.463916284874962*^9, 3.463916291624716*^9}, {3.46391634464233*^9, 
  3.463916385890562*^9}, {3.510396999251703*^9, 3.510397051270656*^9}, {
  3.510397087008335*^9, 3.510397128447055*^9}, {3.904284886026519*^9, 
  3.9042849061757174`*^9}, {3.905567329393024*^9, 
  3.905567361708363*^9}},ExpressionUUID->"b0036507-8555-4025-9d10-\
ada1e883f856"],

