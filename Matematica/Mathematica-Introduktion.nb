Cell[TextData[{
 "H\[ADoubleDot]r var det viktigt att vi anropade ",
 ButtonBox["Clear",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Clear"],
 " f\[ODoubleDot]rst. Annars hade variablen ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "d9098663-88c7-46d4-8630-7e577730584b"],
 " automatiskt ersatts med uttrycket ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], "-", "4"}], TraditionalForm]],ExpressionUUID->
  "f8310c2f-c118-49d3-9f38-ed66a6085879"],
 " och svaret  hade blivit n\[ARing]got helt annat."
}], "Text",
 CellChangeTimes->{{3.461322610595893*^9, 3.461322726852301*^9}, {
  3.461325368221146*^9, 
  3.461325375139794*^9}},ExpressionUUID->"1d7ed826-f45c-42a3-8a1a-\
eb3f83fa31c1"],

