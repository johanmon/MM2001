Cell[TextData[{
 "En skillnad mot att anv\[ADoubleDot]nda en minir\[ADoubleDot]knare \
\[ADoubleDot]r att ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", s\[ARing] l\[ARing]ngt det \[ADoubleDot]r m\[ODoubleDot]jligt, ber\
\[ADoubleDot]knar allting exakt. Detta g\[ADoubleDot]ller exempelvis stora \
tal och br\[ARing]k. Br\[ARing]k f\[ODoubleDot]rkortas automatiskt s\[ARing] \
l\[ARing]ngt det \[ADoubleDot]r m\[ODoubleDot]jligt."
}], "Text",
