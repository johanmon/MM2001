   3.906453542849622*^9}},ExpressionUUID->"d8c49626-9c68-43f3-b69c-\
d017d47b7036"],

Cell[TextData[{
 StyleBox["G\[ODoubleDot]ra datorgenererad konst",
  FontWeight->"Bold"],
 ". Kan du generera snygga bilder (",
 StyleBox["generative art",
  FontSlant->"Italic"],
 ")? Till exempel, kan du skriva en funktion som tillverkar en slumpm\
\[ADoubleDot]ssig design i Piet Mondrian\[CloseCurlyQuote]s stil?"
}], "Item",
 CellChangeTimes->{{3.686161676251524*^9, 3.686161939997737*^9}, {
   3.686161980844859*^9, 3.686162054900323*^9}, {3.686162110657276*^9, 
