Cell[TextData[{
 StyleBox["Pseudovetenskapliga ber\[ADoubleDot]ttelser",
  FontWeight->"Bold"],
 ". G\[ODoubleDot]r ett program som automatiskt genererar \
(slumpm\[ADoubleDot]ssiga) ber\[ADoubleDot]ttelser om hur man botar \
\[ARing]kommor med tvivelaktiga metoder. Exempel fr\[ARing]n min egen \
implementation nedan:\[LineSeparator]\[LineSeparator]",
 StyleBox["I saw on YouTube that my cousin\[CloseCurlyQuote]s friend\
\[CloseCurlyQuote]s friend\[CloseCurlyQuote]s trailer-park guard overcame his \
late-stage pregnancy using gluten-free better genes, a diet of gluten-free \
water and post-modernistic pills.",
  FontSlant->"Italic"],
 "\[LineSeparator]\[LineSeparator]",
 StyleBox["I heard that my coworker\[CloseCurlyQuote]s caretaker overcame his \
chronic bad fourier transform using a diet of ketogenic aloe vera, a diet of \
unprocessed colloidal silver and gluten-free secret baking soda.", "Text",
  FontSlant->"Italic"]
}], "Item",
 CellChangeTimes->{{3.686161676251524*^9, 3.686161939997737*^9}, {
