Cell[TextData[{
 StyleBox["Young-tabl\[ARing]er",
  FontWeight->"Bold"],
 ". L\[ADoubleDot]s om Young-tabl\[ARing]er p\[ARing] Wikipedia. Skriv en \
metod som givet en heltalspartition genererar alla Young-tabl\[ARing]er med \
de givna parametrarna. (Detta har man nytta av om man jobbar med algebraisk \
kombinatorik)."
}], "Item",
 CellChangeTimes->{{3.686161676251524*^9, 3.686161939997737*^9}, {
   3.686161980844859*^9, 3.686162054900323*^9}, {3.686162110657276*^9, 
