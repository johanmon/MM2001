  3.6861436907461767`*^9}},ExpressionUUID->"476ae426-be7d-40d7-b47b-\
749b045cecfc"],

Cell["men, observera, resultatet blir en bild! Om man skriver", "Text",
 CellChangeTimes->{{3.686143771418745*^9, 3.686143800289611*^9}, {
   3.686143910673778*^9, 3.686143919467656*^9}, 
