Cell[TextData[{
 "Genom att forma uttryck med siffor, parenteser samt operationerna +, -, * \
och / (f\[ODoubleDot]r addition, subtraktion, multiplikation, respektive \
division) kan man anv\[ADoubleDot]nda ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " ungef\[ADoubleDot]r som en vanlig minir\[ADoubleDot]knare. N\[ADoubleDot]r \
man har skrivit sitt uttryck anv\[ADoubleDot]nder man tangentkombinationen ",
 StyleBox["Shift+Enter",
  FontWeight->"Bold"],
 " f\[ODoubleDot]r att utf\[ODoubleDot]ra ber\[ADoubleDot]kningen."
}], "Text",
 CellChangeTimes->{{3.461303651344381*^9, 3.461303801769148*^9}, {
  3.461303855107364*^9, 3.461303880927158*^9}, {3.461304111810846*^9, 
