   RowBox[{"kvadreraOchAdderaEtt", "[", "talet_", "]"}], ":=", 
   RowBox[{
    RowBox[{"talet", "^", "2"}], "+", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"x", "^", "2"}], " ", "+", " ", 
