   3.906453553716075*^9, 3.9064535630016603`*^9}, {3.906453696316433*^9, 
   3.906453789451288*^9}},ExpressionUUID->"e6132577-f743-4048-8b59-\
c89d7095ed44"],

Cell[TextData[{
 StyleBox["En sudokul\[ODoubleDot]sare",
  FontWeight->"Bold"],
 ". Skriv en funktion som tar en ol\[ODoubleDot]st Sudoku som input, och \
genererar den l\[ODoubleDot]sta versionen."
}], "Item",
 CellChangeTimes->{{3.686161676251524*^9, 3.686161939997737*^9}, {
   3.686161980844859*^9, 3.686162054900323*^9}, {3.686162110657276*^9, 
