 CellLabel->"In[5]:=",ExpressionUUID->"63419aab-4eaa-4081-9da5-4df70382770e"],

Cell[TextData[{
 "Ett bra s\[ADoubleDot]tt att skaffa sig en ungef\[ADoubleDot]rlig \
uppfattning om hur en funktion upptr\[ADoubleDot]der \[ADoubleDot]r att \
skissa dess graf. I ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " finns flera inbyggda funktioner f\[ODoubleDot]r att rita, eller plotta, \
funktioner. F\[ODoubleDot]r att plotta en funktion i en variabel anv\
\[ADoubleDot]nder man kommandot ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    ButtonBox["Plot",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Expand"],
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Plot"], TraditionalForm]],ExpressionUUID->
  "71b9241d-ec07-497c-9a8a-5eafe3889e56"],
 "."
}], "Text",
 CellChangeTimes->{{3.5114941131616716`*^9, 3.511494237992811*^9}, {
