Cell[CellGroupData[{

Cell["5. Listor", "Section",
 CellChangeTimes->{{3.6858619360958014`*^9, 3.685861950401301*^9}, {
  3.9048746823749332`*^9, 
  3.9048746834112883`*^9}},ExpressionUUID->"5efb496e-e340-4638-9367-\
1b76212cb0f2"],

Cell["\<\
Listan \[ADoubleDot]r ett viktigt verktyg i programmering. Vi kan t\
\[ADoubleDot]nka p\[ARing] en lista lite som en m\[ADoubleDot]ngd, d\
\[ADoubleDot]r vi lagrar data: tal, funktioner, andra listor, och s\[ARing] \
vidare. Listor i Mathematica skrivs med m\[ARing]svingar:\
\>", "Text",
 CellChangeTimes->{{3.6858574370122757`*^9, 3.6858575012329082`*^9}, {
  3.686142925491716*^9, 3.686142926552676*^9}, {3.686143210554193*^9, 
  3.686143233047286*^9}, {3.686228184794971*^9, 
  3.6862281859289217`*^9}},ExpressionUUID->"59dd1430-9ea2-4d86-8634-\
517609566e16"],

Cell[BoxData[
 RowBox[{"lista", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4", ",", "6"}], "}"}]}], "}"}], " "}]], "Input",
 CellChangeTimes->{{3.68585750716337*^9, 3.685857525351253*^9}, {
  3.68615999706223*^9, 
  3.686160046645767*^9}},ExpressionUUID->"7f77d8a3-60c5-489f-b6f2-\
2c7c854a51fa"],

Cell["\<\
\[ADoubleDot]r en giltig lista, med fyra element: 1, 2, 3 samt listan \
{1,4,6}. Varje element i listan skiljs \[ARing]t med kommatecken. Listor med \
tal \[ADoubleDot]r samma sak som vektorer.\
\>", "Text",
 CellChangeTimes->{{3.6858575309456472`*^9, 3.6858575338818283`*^9}, {
  3.6858580761206083`*^9, 3.685858090284404*^9}, {3.685858811479629*^9, 
  3.6858588572209044`*^9}, {3.6858822645249233`*^9, 3.685882461464272*^9}, {
  3.686142810873013*^9, 3.686142835673936*^9}, {3.686143164502207*^9, 
  3.6861431869190283`*^9}, {3.686143229601461*^9, 3.686143281501742*^9}, {
  3.686159915860066*^9, 3.686159991841202*^9}, {3.686160059132504*^9, 
  3.6861601570946283`*^9}, {3.904285129049885*^9, 
  3.904285162038114*^9}},ExpressionUUID->"c1407085-41f7-4365-b30c-\
dc4e214d8228"],

Cell["\<\
Ytterligare en anv\[ADoubleDot]ndning \[ADoubleDot]r att para ihop argument \
som h\[ODoubleDot]r ihop n\[ADoubleDot]r man anropar en funktion. T.ex. om du \
vill rita ut (\[OpenCurlyDoubleQuote]plotta\[CloseCurlyDoubleQuote]) \
funktionen f(x) = x^2, d\[ARing] x g\[ARing]r fr\[ARing]n 0 till 10, parar \
man ihop argumenten som handlar om vilket intervall man ska rita ut: vi \
skriver {x, 0, 10}.
Vi kan ocks\[ARing] t\[ADoubleDot]nka oss listor av listor. Ett viktigt anv\
\[ADoubleDot]ndningsomr\[ARing]de \[ADoubleDot]r matriser. De representeras \
med listor av listor, d\[ADoubleDot]r de inre listorna alla har samma \
storlek. Till exempel kan vi ha matriserna\
\>", "Text",
 CellChangeTimes->{
  3.686160371365427*^9, {3.904285192947298*^9, 
   3.9042851943303823`*^9}},ExpressionUUID->"ea83d0ce-e7fa-4b31-ac20-\
8e9fbd345e4e"],

Cell[BoxData[{
 RowBox[{"A", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"B", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "2"}], "}"}]}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.685882489958679*^9, 3.685882520353483*^9}, 
   3.6861437429014606`*^9, {3.686215213444909*^9, 
   3.686215241224307*^9}},ExpressionUUID->"1a6e521e-e989-4b02-b88a-\
b279b9141060"],

Cell[TextData[{
 "som en lista av listor. De inre listorna representerar matrisens rader. ",
 StyleBox["A", "Input"],
 " \[ADoubleDot]r allts\[ARing] en 3x2-matris. Vill man se matrisen lite l\
\[ADoubleDot]sligare kan man skriva"
}], "Text",
 CellChangeTimes->{
  3.6861437260314302`*^9, {3.686144010423348*^9, 
