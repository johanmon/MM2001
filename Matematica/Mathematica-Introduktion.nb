4849d123f3eb"],

Cell[TextData[{
 "Det \[ADoubleDot]r ofta praktiskt att ge sina uttryck ett namn s\[ARing] \
att man slipper skriva dem om och om igen om man anv\[ADoubleDot]nder de \
flera g\[ARing]nger. Vi kallar ovanst\[ARing]ende polynom f\[ODoubleDot]r ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "0b6ffb58-698d-4922-b0e6-bea7bbcde703"],
 "."
}], "Text",
 CellChangeTimes->{{3.461318805215488*^9, 3.461318862120571*^9}, {
  3.461318921056863*^9, 3.46131897015453*^9}, {3.46132001112196*^9, 
  3.461320047260038*^9}, {3.461321027672817*^9, 3.46132105421167*^9}, {
  3.461321114218143*^9, 3.461321130468494*^9}, {3.46132117105796*^9, 
  3.461321226889574*^9}, {3.461321258034158*^9, 
  3.461321270791855*^9}},ExpressionUUID->"f697f09a-3fe7-481a-8379-\
0b0ea92afc8e"],

