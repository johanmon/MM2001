 RowBox[{"Sin", "[", "Pi", "]"}]], "Input",
 CellChangeTimes->{{3.4613063193413*^9, 
  3.461306321482106*^9}},ExpressionUUID->"856f0c06-db40-4751-8d74-\
936e238d20f0"],

Cell[TextData[{
 "Funktioner anv\[ADoubleDot]nds vanligen med hakparenterser. Funktioner som \
tar ett enda argument kan man dock anv\[ADoubleDot]nda p\[ARing] tv\[ARing] \
andra s\[ADoubleDot]tt, antingen genom ",
 StyleBox["@", "Input"],
 " (snabel-a) symbolen eller med ",
 StyleBox["//", "Input"],
 ".  Det senare kallas f\[ODoubleDot]r \[OpenCurlyQuote]pipe-notation\
\[CloseCurlyQuote] och man t\[ADoubleDot]nker sig att det till \
v\[ADoubleDot]nster skickas vidare in till funktionen till h\[ODoubleDot]ger. \
Snabel-a notationen ska p\[ARing]minna om \[SmallCircle]  vilket anv\
\[ADoubleDot]nds inom matematiken f\[ODoubleDot]r funktionssammans\
\[ADoubleDot]ttning. \n Vill man anv\[ADoubleDot]nda flera funktioner efter \
varandra, s\[ARing] \[ADoubleDot]r b\[ARing]da dessa alternativa skrivs\
\[ADoubleDot]tt lite l\[ADoubleDot]ttare att l\[ADoubleDot]sa. De tre skrivs\
\[ADoubleDot]tten nedan ger allts\[ARing] samma resultat. Det g\[ARing]r ocks\
\[ARing] bra att blanda: ",
 StyleBox["Sin@ArcTan[19/17]//N", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.9055674516593018`*^9, 3.9055676345477448`*^9}, {
  3.905567705803856*^9, 3.905567844865263*^9}, {3.905567881031369*^9, 
  3.905567891626096*^9}},ExpressionUUID->"cb5f1d9a-16e2-47d0-a2a3-\
02e770a09635"],

Cell[BoxData[{
 RowBox[{"N", "[", 
  RowBox[{"Sin", "[", 
   RowBox[{"ArcTan", "[", 
    RowBox[{"19", "/", "17"}], "]"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"N", "@", 
  RowBox[{"Sin", "@", 
   RowBox[{"ArcTan", "@", 
    RowBox[{"(", 
     RowBox[{"19", "/", "17"}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"19", "/", "17"}], ")"}], "//", "ArcTan"}], "//", "Sin"}], "//", 
  "N"}]}], "Input",
 CellChangeTimes->{{3.9055676086608047`*^9, 3.905567609534688*^9}, {
  3.905567641428466*^9, 3.9055676962310753`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"fec4dc23-658c-4ab7-9926-9685d6cd569b"]
