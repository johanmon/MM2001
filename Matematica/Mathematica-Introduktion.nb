dac9edb47b38"],

Cell[TextData[{
 "Det h\[ADoubleDot]r betyder att vi definierar en funktion ",
 StyleBox["f",
  FontSlant->"Italic"],
 "  i en variabel ",
 StyleBox["x",
  FontSlant->"Italic"],
 ". L\[ADoubleDot]gg m\[ADoubleDot]rke till understrykningsstrecket efter \
variabeln ",
 StyleBox["x",
  FontSlant->"Italic"],
 " i v\[ADoubleDot]nsterledet och att operatorn ",
 Cell[BoxData[
  FormBox[
   ButtonBox[":=",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/SetDelayed"], TraditionalForm]],ExpressionUUID->
  "620a6b61-54d1-477b-97a5-4932cefa6a32"],
