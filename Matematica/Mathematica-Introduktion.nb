Cell[CellGroupData[{

Cell["7. Utmaningar f\[ODoubleDot]r den intresserade", "Section",
 CellChangeTimes->{{3.6861616212092047`*^9, 3.6861616254690247`*^9}, {
  3.904874686875248*^9, 3.904874687979949*^9}, {3.9064533564893913`*^9, 
  3.906453365359152*^9}},ExpressionUUID->"11360a35-a641-4d59-a721-\
b67d222c280c"],

Cell["\<\
Vi ger i denna kurs bara en liten inblick i vad man kan g\[ODoubleDot]ra med \
Mathematica och du uppmuntras att experimentera p\[ARing] egen hand. Om du \
redan kan programmera lite s\[ARing] kan du f\[ODoubleDot]rs\[ODoubleDot]ka \
ta dig an n\[ARing]got av de mer avancerade projekten nedan.\
\>", "Text",
 CellChangeTimes->{{3.9042857483275013`*^9, 3.904285778768338*^9}, {
   3.90487471378651*^9, 3.904874739578412*^9}, {3.905568002440362*^9, 
