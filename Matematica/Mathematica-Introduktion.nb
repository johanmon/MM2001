  RowBox[{"[", "3", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.6861441921410522`*^9, 
  3.6861441974865017`*^9}},ExpressionUUID->"7a9cecdb-7e49-4f20-8e43-\
ad3cb9834df7"],

Cell["\<\
Observera att det \[ADoubleDot]r dubbla hakparenteser - ett par hakparenteser \
betyder ju evaluering av en funktion p\[ARing] ett argument, t.ex. f[x]. F\
\[ODoubleDot]r att plocka ut elementet p\[ARing] plats (1,2) i matrisen A, \
skriver vi - ja, vi ska plocka ut rad 1 f\[ODoubleDot]rst, och fr\[ARing]n \
den ska vi plocka ut element 2:\
\>", "Text",
 CellChangeTimes->{
  3.686144546269045*^9, {3.904285261358513*^9, 
   3.9042852639197063`*^9}},ExpressionUUID->"e4cc3976-475b-41a6-b5ba-\
