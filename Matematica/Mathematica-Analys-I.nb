Cell[CellGroupData[{

Cell["4. En dynamisk tangent", "Section",
 CellChangeTimes->{{3.904882533940013*^9, 3.904882550966592*^9}, {
  3.904888623370873*^9, 3.904888631600934*^9}, {3.90488929195129*^9, 
  3.904889299030675*^9}, {3.904889781455222*^9, 3.904889804911365*^9}, {
  3.904890476861681*^9, 3.904890477720066*^9}, {3.905320834053993*^9, 
  3.90532083487199*^9}},ExpressionUUID->"766bdd34-68ce-4978-93e5-\
3a06a47dbac9"],

Cell["\<\
L\[ARing]t oss rita tangenten till en funktion h(x), f\[ODoubleDot]r ett v\
\[ADoubleDot]rde p\[ARing] x=a, d\[ADoubleDot]r vi kan variera a.
Tangenten \[ADoubleDot]r ju en funktion i x, men vi f\[ARing]r ju en tangent \
genom (a,f(a)) f\[ODoubleDot]r varje v\[ADoubleDot]rde p\[ARing] parametern a.\
\>", "Text",
 CellChangeTimes->{{3.9048898089009523`*^9, 3.9048898176301947`*^9}, {
   3.9048899086108437`*^9, 3.904889987394699*^9}, {3.904890083162139*^9, 
   3.904890129666918*^9}, {3.904890233451621*^9, 3.904890244191143*^9}, 
   3.905320828931938*^9},ExpressionUUID->"11523cfa-52a4-417d-936b-\
4dcea3214c9a"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], "+", 
      RowBox[{"0.3", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"3", "x"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"tangent", "[", 
      RowBox[{"a_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"h", "[", "a", "]"}], "+", 
      RowBox[{
       RowBox[{
        RowBox[{"h", "'"}], "[", "a", "]"}], 
       RowBox[{"(", 
        RowBox[{"x", "-", "a"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Plotta", " ", "funktionen", " ", "samt", " ", "tangenten", " ", "vid", 
      " ", "x"}], "=", "2.3"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", "[", "x", "]"}], ",", 
       RowBox[{"tangent", "[", 
        RowBox[{"2.3", ",", "x"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "6"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9048899671932793`*^9, 3.904890029050755*^9}, {
  3.9048901323225393`*^9, 
  3.904890171341408*^9}},ExpressionUUID->"4d9c150e-cdb6-44fb-b513-\
dd5188bf727d"],

Cell[TextData[{
 "Man kan skapa interaktiva bilder ocks\[ARing], d\[ADoubleDot]r bilden \
uppdateras d\[ARing] en parameter \[ADoubleDot]ndras . Vi \
anv\[ADoubleDot]nder kommandot ",
 StyleBox["Manipulate", "Input"],
 " f\[ODoubleDot]r  detta \[ADoubleDot]ndam\[ARing]l.  "
}], "Text",
 CellChangeTimes->{
  3.904890184604993*^9, {3.904890248214284*^9, 
   3.9048903008163967`*^9}},ExpressionUUID->"83bef6a9-c135-4eed-bc5e-\
ec11c930d1dd"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", "[", "x", "]"}], ",", 
       RowBox[{"tangent", "[", 
        RowBox[{"a", ",", "x"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "6"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}]}], "}"}]}], 
    "]"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", "6"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.904890280038006*^9, 3.904890280708517*^9}, {
   3.9048903108379993`*^9, 3.904890351994903*^9}, 
   3.904890450570703*^9},ExpressionUUID->"72657a2e-7500-4ce2-ae2f-\
28d0d1787b7f"]
}, Open  ]],

