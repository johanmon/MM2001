Notebook[{

Cell[CellGroupData[{
Cell["Analys med Mathematica", "Title",
 CellChangeTimes->{{3.904373071591951*^9, 3.9043731054733562`*^9}, {
  3.904881172470171*^9, 
  3.904881174123925*^9}},ExpressionUUID->"95a0e28e-eca8-4d94-bf36-\
11636955eed9"],

Cell["\<\
I denna notebook jobbar vi med att unders\[ODoubleDot]ka funktioner och att \
rita grafer.\
\>", "Text",
 CellChangeTimes->{{3.904881693201462*^9, 3.9048817427803164`*^9}, {
  3.904882510204208*^9, 
  3.904882533074835*^9}},ExpressionUUID->"94c58e21-6159-4771-82ec-\
f7565e02f031"],

Cell[CellGroupData[{

Cell["1. Invers till en funktion", "Section",
 CellChangeTimes->{{3.904882533940013*^9, 
  3.904882550966592*^9}},ExpressionUUID->"e3dc4f19-62d2-4d60-b830-\
71d45bf927ef"],

Cell["L\[ARing]t oss unders\[ODoubleDot]ka f(x)=x+sin(x) p\[ARing] \
intervallet [0,\[Pi]/2].", "Text",
 CellChangeTimes->{{3.904881693201462*^9, 3.9048817427803164`*^9}, {
  3.904882510204208*^9, 3.904882533074835*^9}, {3.904882575739767*^9, 
  3.9048826084028254`*^9}},ExpressionUUID->"ba30e9ed-0978-418f-ac8f-\
87c6fd3356c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{"x", "+", 
    RowBox[{"Sin", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
   RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.904882638137514*^9, 3.904882646646385*^9}, {
   3.9048826796762037`*^9, 3.904882695912245*^9}, 3.904882894749052*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"8adecbd4-e396-45f8-9ad1-3487e4114808"],

Cell["\<\
Funktionen \[ADoubleDot]r v\[ADoubleDot]xande p\[ARing] detta intervall, s\
\[ARing] den har en invers. Vi kan numeriskt skapa en lista med punkter, \
(x,f(x)) som ligger p\[ARing] grafen.
Vi kan sedan plotta dessa punkter, och ser att de bildar samma kurva som \
plotten ovan.\
\>", "Text",
 CellChangeTimes->{{3.904881693201462*^9, 3.9048817427803164`*^9}, {
  3.904882510204208*^9, 3.904882533074835*^9}, {3.904882575739767*^9, 
  3.9048826084028254`*^9}, {3.904882657388308*^9, 3.90488267192347*^9}, {
  3.9048827120942507`*^9, 3.9048827419242783`*^9}, {3.904882907250772*^9, 
  3.904882937687828*^9}},ExpressionUUID->"b044299f-ba81-4ef9-8870-\
1c1622997fe4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Detta", " ", "skapar", " ", "en", " ", "lista", " ", "med", " ", 
     "punkter"}], ",", " ", 
    RowBox[{"d\[ADoubleDot]r", " ", 
     RowBox[{"vi", " ", "'"}], 
     RowBox[{"samplar", "'"}], " ", "funktionen", " ", "p\[ARing]", " ", 
     "intervall", " ", "med", " ", "l\[ADoubleDot]ngden", " ", 
     RowBox[{"0.001", ".", " ", "Det"}], " ", "\[ADoubleDot]r", " ", "lite", 
     " ", "drygt", " ", "1500", " ", 
     RowBox[{"punkter", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fPoints", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"f", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", 
         RowBox[{"Pi", "/", "2"}], ",", "0.001"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"fGraph", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"fPoints", ",", 
      RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9048827434560328`*^9, 3.904882874052486*^9}, {
  3.904882953868438*^9, 
  3.904882990239551*^9}},ExpressionUUID->"d08ddb8f-e1bd-4bc1-9060-\
760117b18b3d"],

Cell[TextData[{
 "Den inversen till ",
 "f(x)",
 StyleBox[" ",
  FontSlant->"Italic"],
 "skickar f(x) p\[ARing] x, s\[ARing] vi kan approximera denna genom att byta \
plats p\[ARing] x och y-koordinaterna."
}], "Text",
 CellChangeTimes->{{3.904881693201462*^9, 3.9048817427803164`*^9}, {
  3.904882510204208*^9, 3.904882533074835*^9}, {3.904882575739767*^9, 
  3.9048826084028254`*^9}, {3.904882657388308*^9, 3.90488267192347*^9}, {
  3.9048827120942507`*^9, 3.9048827419242783`*^9}, {3.904882907250772*^9, 
  3.904882937687828*^9}, {3.904883003848536*^9, 3.904883051804302*^9}, {
  3.904883085466652*^9, 
  3.904883109047217*^9}},ExpressionUUID->"1bbc38b8-dac3-4456-88bc-\
ca7be2c9e58b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fInvPoints", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "[", "x", "]"}], ",", "x"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"Pi", "/", "2"}], ",", "0.001"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"fInvGraph", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"fInvPoints", ",", 
    RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.904883065692829*^9, 3.9048830769610653`*^9}, 
   3.9048831113538923`*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"1aaa32ce-3f81-460e-85e5-8d0c286caeec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Rita", " ", "punkt"}], "-", 
     RowBox[{"approximationen", " ", "f\[ODoubleDot]r", " ", "f"}]}], ",", 
    " ", 
    RowBox[{"samt", " ", "dess", " ", 
     RowBox[{"invers", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Show", "[", 
   RowBox[{"fGraph", ",", "fInvGraph", ",", 
    RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9048831202666817`*^9, 
  3.904883153659295*^9}},ExpressionUUID->"27efac24-8b29-4738-a981-\
dee1a1b0692c"],

Cell[TextData[{
 "Vi kan nu slutligen g\[ODoubleDot]ra om listan med punkter till en ",
 StyleBox["interpolerad funktion",
  FontSlant->"Italic"],
 ",\ndvs. en funktion som \[ADoubleDot]r en anpassning till punkterna. Vi kan \
sedan anv\[ADoubleDot]nda detta som en vanlig funktion, definierad p\[ARing] \
intervallet [0,1+Pi/2]."
}], "Text",
 CellChangeTimes->{{3.904881693201462*^9, 3.9048817427803164`*^9}, {
  3.904882510204208*^9, 3.904882533074835*^9}, {3.904882575739767*^9, 
  3.9048826084028254`*^9}, {3.904882657388308*^9, 3.90488267192347*^9}, {
  3.9048827120942507`*^9, 3.9048827419242783`*^9}, {3.904882907250772*^9, 
  3.904882937687828*^9}, {3.904883003848536*^9, 3.904883051804302*^9}, {
  3.904883085466652*^9, 3.904883109047217*^9}, {3.9048831808162613`*^9, 
  3.9048832220365543`*^9}, {3.904883342810122*^9, 
  3.9048833730558147`*^9}},ExpressionUUID->"1058c9b3-2077-4ccc-9487-\
57e85c2cd5f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fInv", "=", 
   RowBox[{"Interpolation", "[", "fInvPoints", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"fInv", "[", "0.5", "]"}]}], "Input",
 CellChangeTimes->{{3.904883225385827*^9, 3.904883337755411*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"29948a6a-efd1-4926-b67d-3acff5324fd8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Det", " ", "g\[ARing]r", " ", "att", " ", "numeriskt", " ", "integrera", 
    " ", "den", " ", "inversa", " ", "funktionen"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"fInv", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "0.5"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.904883384212215*^9, 
  3.904883424163251*^9}},ExpressionUUID->"f202a6a0-a69d-454e-9cf3-\
9b3cd443233d"],

Cell[TextData[{
 "Sammans\[ADoubleDot]ttningen av en funktion och dess invers ska ju bli ",
 StyleBox["x",
  FontSlant->"Italic"],
 ", och detta kan vi kontrollera genom att plotta \
sammans\[ADoubleDot]ttningen:"
}], "Text",
 CellChangeTimes->{{3.904883460987259*^9, 
  3.9048834934062853`*^9}},ExpressionUUID->"7f350c0b-4cb1-460e-9d8f-\
78d364b0cdde"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"fInv", "[", "x", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{
      RowBox[{"Pi", "/", "2"}], "+", "1"}]}], "}"}], ",", 
   RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.904883427243599*^9, 3.9048834515653*^9}, 
   3.905239308859563*^9},ExpressionUUID->"b4604f73-37ac-4a5d-9907-\
0d5834159b5c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Extrempunkter till en funktion", "Section",
 CellChangeTimes->{{3.904882533940013*^9, 3.904882550966592*^9}, {
  3.9048835110088167`*^9, 
  3.904883514360017*^9}},ExpressionUUID->"7fc7acad-1b98-4a83-ad98-\
01d72cb5f324"],

Cell["\<\
Genom att plotta en funktion, kan vi enkelt hitta extrempunkterna. Man kan \
\[ADoubleDot]ndra intervallet d\[ADoubleDot]r funktionen plottas, f\
\[ODoubleDot]r att se det lokala beteendet.\
\>", "Text",
 CellChangeTimes->{{3.904883543790638*^9, 3.904883566540951*^9}, {
  3.904883642209202*^9, 
  3.904883662075696*^9}},ExpressionUUID->"26e253d3-961a-4642-b79e-\
a3f9b9a90326"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "f", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{"2.1", "+", 
    RowBox[{"1.5", "x"}], "-", 
    RowBox[{"1.23", " ", 
     RowBox[{"x", "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "^", "3"}], ")"}], "/", "3"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "4"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "1.1", ",", "1.6"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.904883567519943*^9, 3.9048836338950872`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"9a6ff27a-2411-4ac3-9f6e-652681764338"],

Cell["\<\
I detta fall kan man derivera funktionen och se var derivatan \[ADoubleDot]r \
noll, men f\[ODoubleDot]r mer komplicerade funktioner kan man inte hitta alla \
nollst\[ADoubleDot]llen till derivatan.\
\>", "Text",
 CellChangeTimes->{{3.904883543790638*^9, 3.904883566540951*^9}, {
  3.904883642209202*^9, 3.904883662075696*^9}, {3.905239335505042*^9, 
  3.905239391899397*^9}},ExpressionUUID->"8909ab68-885c-4146-a808-\
02d135424c77"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. L\[ODoubleDot]sning av ekvationer numeriskt", "Section",
 CellChangeTimes->{{3.904882533940013*^9, 3.904882550966592*^9}, {
  3.9048835110088167`*^9, 3.904883514360017*^9}, {3.905239448304631*^9, 
  3.9052394575629387`*^9}},ExpressionUUID->"8e9a31de-81cf-46c8-9745-\
3ddf41c64e9e"],

Cell[TextData[{
 "L\[ARing]t oss f\[ODoubleDot]rs\[ODoubleDot]ka hitta alla \
r\[ODoubleDot]tter till derivatan till funktionen ",
 StyleBox["w(x)", "InlineFormula"],
 " nedan p\[ARing] intervallet ",
 StyleBox["[0,\[Pi]/2]", "InlineFormula"],
 "."
}], "Text",
 CellChangeTimes->{{3.904883543790638*^9, 3.904883566540951*^9}, {
  3.904883642209202*^9, 3.904883662075696*^9}, {3.905239519475842*^9, 
  3.9052395736659813`*^9}, {3.905239681186803*^9, 
  3.90523970742109*^9}},ExpressionUUID->"4809d1d6-f7d2-4236-8131-\
26e979347b59"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"w", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Sin", "[", "x", "]"}], ")"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"5", "/", "2"}], ")"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Cos", "[", 
         RowBox[{"x", "/", "2"}], "]"}], ")"}], "^", "2"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Vi", " ", "ritar", " ", "funktionen", " ", "samt", " ", "dess", " ", 
    RowBox[{"derivata", ".", " ", "Man"}], " ", "kan", " ", "specificera", 
    " ", "stilen", " ", "p\[ARing]", " ", "graferna", " ", "med", " ", 
    "PlotStyle"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"w", "[", "x", "]"}], ",", 
     RowBox[{
      RowBox[{"w", "'"}], "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Black"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Dashed", ",", "Orange"}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.905239568551289*^9, 3.905239686176526*^9}, 
   3.906192040060528*^9},ExpressionUUID->"841fe43c-774d-4f6c-9a6e-\
a65a71418f0e"],

