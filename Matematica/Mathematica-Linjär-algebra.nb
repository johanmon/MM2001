Cell[TextData[{
 "Vi l\[ODoubleDot]ser detta genom att skriva in listan med ekvationer till \
kommandot ",
 StyleBox["Solve", "Input"],
 ". Notera att likhetstecken i ekvationer skrivs in som ",
 StyleBox["==", "Input"],
 ", dvs. tv\[ARing] stycken likhetstecken. Detta f\[ODoubleDot]r att inte \
blanda ihop med enkelt likhetstecken som anv\[ADoubleDot]nds vid \
definitioner.\[LineSeparator]De variabler som vi vill l\[ODoubleDot]sa ut ges \
som en lista som andra argument. Notera att man m\[ARing]ste ha ett mellanrum \
mellan ",
 StyleBox["a", "Input"],
 " och ",
 StyleBox["z", "Input"],
 "."
}], "Text",
 CellChangeTimes->{{3.9047095765548983`*^9, 3.904709713053187*^9}, {
  3.9048745817208014`*^9, 
  3.904874593333918*^9}},ExpressionUUID->"a5d1daae-5b2d-4e75-b7e6-\
c9f8cfc1f79d"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   StyleBox[
    RowBox[{"Clear", "[", 
     RowBox[{"a", ",", "x", ",", "y", ",", "z"}], "]"}],
    FontWeight->"Bold"], "\[IndentingNewLine]", 
   RowBox[{"sol", "=", 
    StyleBox[
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", " ", "\[Minus]", " ", "y"}], " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", " ", "+", " ", "1"}], ")"}], " ", "z"}]}], " ", "==",
           " ", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"2", " ", "x"}], " ", "\[Minus]", " ", "y"}], " ", "+", 
           " ", 
           RowBox[{"a", " ", "z"}]}], " ", "==", " ", 
          RowBox[{"3", " ", "\[Minus]", " ", "a"}]}], ",", 
         RowBox[{
          RowBox[{"x", " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", " ", "+", " ", "2"}], ")"}], " ", "y"}], " ", "+", 
           " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "a"}], " ", "+", " ", "3"}], ")"}], " ", 
            "z"}]}], " ", "==", " ", 
          RowBox[{
           RowBox[{"2", " ", "a"}], " ", "+", " ", "1"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}],
     FontWeight->"Bold"]}]}]}]], "Input",
 CellChangeTimes->{{3.904709610250733*^9, 3.9047096236925592`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"0b0952cd-27ad-4c58-8968-e053a1bf1e11"],

Cell[TextData[{
 "Det som matas ut \[ADoubleDot]r en lista med l\[ODoubleDot]sningar, i detta \
fall bara en l\[ODoubleDot]sning. Notera att detta \[ADoubleDot]r den ",
 StyleBox["allm\[ADoubleDot]nna",
  FontSlant->"Italic"],
 " l\[ODoubleDot]sningen, fallet ",
 StyleBox["a=-2", "InlineFormula"],
 " m\[ARing]ste behandlas separat. Om man tillf\[ADoubleDot]lligt vill \
tilldela en variabel ett v\[ADoubleDot]rde (inom ett kodblock) kan man anv\
\[ADoubleDot]nda kommandot ",
 StyleBox["Block", "Input"],
 ". Vi slipper d\[ARing] processen att tilldela ",
 StyleBox["a", "InlineFormula"],
 " v\[ADoubleDot]rdet -2 och d\[ADoubleDot]refter komma ih\[ARing]g att k\
\[ODoubleDot]ra ",
 StyleBox["Clear[a]", "Input"],
 ". Detta passar oss utm\[ADoubleDot]rkt, och k\[ODoubleDot]r vi koden nedan \
f\[ARing]r vi den tomma listan som svar, dvs. det saknas \
l\[ODoubleDot]sningar f\[ODoubleDot]r detta v\[ADoubleDot]rde."
}], "Text",
 CellChangeTimes->{{3.9047095765548983`*^9, 3.904709713053187*^9}, {
   3.904709748890456*^9, 3.904709941466642*^9}, 3.904709997770535*^9, {
   3.9047100429861526`*^9, 3.904710059504788*^9}, {3.904874614387866*^9, 
   3.904874614843088*^9}, {3.904875144372052*^9, 
   3.9048751450502167`*^9}},ExpressionUUID->"150d3361-e15c-4c35-9883-\
1e19838984d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
