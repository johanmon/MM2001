Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  StyleBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", " ", "\[Minus]", " ", "y", " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", " ", "+", " ", "1"}], ")"}], " ", "z"}]}], " ", "=", " ",
